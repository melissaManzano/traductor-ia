# Plantilla de variables de entorno. NUNCA subas un archivo ".env" real
# con valores verdaderos a GitHub. Este .env.example solo documenta qué
# variables necesita el backend; los valores reales se configuran
# directamente en Vercel (Settings -> Environment Variables).

# Llave secreta de la API de OpenAI.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dominio exacto donde queda publicado el frontend en GitHub Pages.
# Ejemplo: https://tu-usuario.github.io
ALLOWED_ORIGIN=https://tu-usuario.github.io
